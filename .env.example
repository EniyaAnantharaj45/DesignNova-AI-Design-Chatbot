# ==============================================================================
# DesignNova AI - Environment Configuration & API Keys
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file and rename it to ".env":
#    In Windows PowerShell or CMD: copy .env.example .env
# 2. Add your API key below for the AI service you wish to use.
# 3. Start the server using: npm start  (or: node server.js)
#
# SECURITY NOTICE:
# Never commit your ".env" file to GitHub or share it publicly!
# The server loads keys securely on the backend and never exposes them to clients.
#
# NOTE: DesignNova AI also functions 100% offline with its built-in intelligent
# design engine, client-side vector logo rendering, canvas poster rasterizer,
# PDF resume exporter, PPTX generator, and ZIP portfolio builder.
# ==============================================================================

# Server Port (default is 3000)
PORT=3000

# ------------------------------------------------------------------------------
# Provider 1: OpenAI (GPT-4o, GPT-4o-mini, DALL-E 3)
# ------------------------------------------------------------------------------
# Get your API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# Provider 2: Google Gemini (Gemini 1.5 Flash, Gemini 1.5 Pro)
# ------------------------------------------------------------------------------
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
